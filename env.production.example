#--------------------------------------------------------------------
# NGW Coin Platform — PRODUCTION environment template
# Copy to .env on the server. NEVER commit real secrets.
# Do not overwrite local development .env with production values.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://YOUR-DOMAIN.EXAMPLE/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

# Generate with: php spark key:generate
encryption.key = hex2bin:REPLACE_WITH_64_HEX_CHARS

database.default.hostname = YOUR_DB_HOST
database.default.database = YOUR_DB_NAME
database.default.username = YOUR_DB_USER
database.default.password = YOUR_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Session (FileHandler + writable/session; prefer Redis in multi-node)
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = ngw_session
session.expiration = 7200
session.savePath = WRITEPATH + 'session'
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = true

cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

logger.threshold = 4

# Root sponsor / bootstrap admin — set only for first seed; rotate after
platform.appName = 'Next Generation Wealth'
platform.rootSponsorId = 'ROOT0001'
platform.memberIdPrefix = 'NGW'
platform.adminEmail = 'REPLACE_ADMIN_EMAIL'
platform.adminPassword = 'REPLACE_STRONG_PASSWORD'
platform.adminName = 'Platform Admin'

# Financial safety — keep OFF until separately authorized activation
platform.requireVerifiedDepositForApproval = true
platform.commissionPostingEnabled = false
platform.commissionWithdrawalEnabled = false
platform.commissionBlockchainPayoutEnabled = false

# Optional SMTP for email-change / password-reset
# email.protocol = smtp
# email.SMTPHost = smtp.example.com
# email.SMTPUser = REPLACE
# email.SMTPPass = REPLACE
# email.SMTPPort = 587
# email.SMTPCrypto = tls
# email.fromEmail = noreply@YOUR-DOMAIN.EXAMPLE
# email.fromName = 'Next Generation Wealth'
