#--------------------------------------------------------------------
# NGW Coin Management Platform — Reviewed Production .env Hardening Template
# Apply on the production host ONLY after verifying backup & domain DNS.
# Fixes:
#   1. Disables CI4 Debugbar & error display (CI_ENVIRONMENT = production)
#   2. Fixes mismatched app.baseURL from https://ngw.in.net/ to https://ngw.zodianwealth.info/
#   3. Keeps ALL financial kill-switches FAIL-CLOSED FALSE until separate Phase 8 go-live steps
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://ngw.zodianwealth.info/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

# Fill with production DB host / least-privilege application user (never expose real credentials in git)
database.default.hostname = localhost
database.default.database = ng_database
database.default.username = CHANGE_ME_APP_USER
database.default.password = CHANGE_ME_APP_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Keep existing 32-byte hex2bin encryption key from current live .env (DO NOT rotate without session invalidation plan)
encryption.key = CHANGE_ME_KEEP_EXISTING_LIVE_KEY

# Logs: threshold 4 logs CRITICAL..ERROR in production without flooding disk
logger.threshold = 4

# Platform identity & gates
platform.liveDatabase = ng_database
platform.rootSponsorId = ROOT0001
platform.memberIdPrefix = NGW
platform.memberIdPadding = 6
platform.memberIdStartNumber = 981234
platform.appName = 'Next Generation Wealth'
platform.requireVerifiedDepositForApproval = true
platform.mandatoryPurchaseLockEnabled = true

#--------------------------------------------------------------------
# FINANCIAL KILL-SWITCHES — MUST REMAIN FALSE UNTIL SEPARATE AUTHORIZATION
#--------------------------------------------------------------------
platform.miningPostingEnabled = false
platform.miningAutoPostEnabled = false
platform.miningP2pEnabled = false
platform.commissionPostingEnabled = false
platform.commissionAutoPostOnApprovalEnabled = false
platform.commissionWithdrawalEnabled = false
platform.commissionBlockchainPayoutEnabled = false
platform.coinSellingEnabled = false
